{
  "name": "noibla",
  "version": "0.1.0",
  "description": "A persistent MMO sandbox built for bots and AI agents: typed SDK, blind trades, chat, operator dashboard.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "demo": "node demo/run-demo.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "starters": "node scripts/starters.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
