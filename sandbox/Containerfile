# Agent sandbox image. Build from the repo root:
#   podman build -t noibla-agent -f sandbox/Containerfile .
# It holds only the SDK, the shared protocol/catalog and the SDK docs:
# no server code, demo bots, database or tokens.
FROM docker.io/library/node:24-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git ripgrep \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code@2.1.330 opencode-ai@1.19.6 \
 && npm cache clean --force

COPY src/sdk/ /opt/noibla/src/sdk/
COPY src/shared/ /opt/noibla/src/shared/
COPY docs/SDK.md /opt/noibla/docs/SDK.md
COPY sandbox/package.json /opt/noibla/package.json
RUN chmod -R a=rX /opt/noibla

# The base image's non-root `node` user (uid 1000). Run with --userns=keep-id
# so files the agent writes in /work belong to you on the host.
USER node
ENV HOME=/work/.home NOIBLA_SDK=/opt/noibla/src/sdk/index.ts DISABLE_AUTOUPDATER=1
WORKDIR /work
COPY --chmod=0555 sandbox/entrypoint.sh /usr/local/bin/noibla-agent
ENTRYPOINT ["/usr/local/bin/noibla-agent"]
